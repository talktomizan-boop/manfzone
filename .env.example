# Core runtime
NODE_ENV=development
APP_URL=http://localhost:5173
APP_VERSION=

# Supabase (required)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase (server-only; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Legacy Supabase envs (optional fallback)
SUPABASE_PROJECT_URL=
SUPABASE_API_KEY=

# Email configuration
EMAIL_PROVIDER=supabase_resend
EMAIL_FROM=no-reply@manafzone.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Observability (optional)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_RELEASE=

# Smoke tests / deployment validation (optional)
SMOKE_TEST_SECRET=
SMOKE_TEST_COUPON_CODE=
SMOKE_TEST_NEWSLETTER=true
TEST_EMAIL=
TEST_PASSWORD=

# QA script accounts (optional)
ADMIN_EMAIL=
ADMIN_PASSWORD=
USER_EMAIL=
USER_PASSWORD=

# Role-based access (optional)
# Comma-separated list of emails that should always be treated as admin.
ADMIN_EMAILS=admin@manafzone.com

# Scheduled job secrets (optional)
CRON_SECRET=
